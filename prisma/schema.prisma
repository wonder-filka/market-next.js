generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  phone              String             @unique
  firstName          String
  lastName           String
  passwordHash       String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  walletId           String             @unique
  verificationStatus VerificationStatus @default(UNVERIFIED)
  accounts           Account[]
  CryptoWallet       CryptoWallet[]
  positions          Position[]
  supportChats       SupportChat[]
  sentMessages       SupportMessage[]   @relation("SenderMessages")
  trades             Trade[]
  wallet             Wallet             @relation(fields: [walletId], references: [id])
  assets             UserAsset[]
}

model SupportChat {
  id        String           @id @default(uuid())
  userId    String
  subject   String
  status    ChatStatus       @default(OPEN)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  closedAt  DateTime?
  user      User             @relation(fields: [userId], references: [id])
  messages  SupportMessage[]

  @@index([userId])
}

model SupportMessage {
  id        String      @id @default(uuid())
  chatId    String
  senderId  String
  content   String
  isSupport Boolean     @default(false)
  isRead    Boolean     @default(false)
  createdAt DateTime    @default(now())
  chat      SupportChat @relation(fields: [chatId], references: [id])
  sender    User        @relation("SenderMessages", fields: [senderId], references: [id])

  @@index([chatId])
  @@index([senderId])
}

model Wallet {
  id        String   @id @default(uuid())
  balance   Float    @default(0)
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  withdrawn Float    @default(0)
  user      User?
}

model Account {
  id         String     @id @default(uuid())
  mt5Id      String     @unique
  isDemo     Boolean    @default(true)
  type       String
  balance    Float
  freeMargin Float
  currency   String     @default("USD")
  userId     String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id])
  positions  Position[]
  trades     Trade[]
}

model Trade {
  id         String      @id @default(uuid())
  asset      String
  type       TradeType
  quantity   Float
  price      Float
  total      Float
  status     TradeStatus
  startDate  DateTime
  endDate    DateTime
  userId     String
  createdAt  DateTime    @default(now())
  accountId  String
  stopLoss   Float?
  takeProfit Float?
  account    Account     @relation(fields: [accountId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
}

model Position {
  id        String         @id @default(uuid())
  asset     String
  type      TradeType
  quantity  Float
  entry     Float
  current   Float
  pnl       Float
  status    PositionStatus
  date      DateTime
  userId    String
  createdAt DateTime       @default(now())
  accountId String
  endDate   DateTime?
  startDate DateTime       @default(now())
  account   Account        @relation(fields: [accountId], references: [id])
  user      User           @relation(fields: [userId], references: [id])
}

model UserAsset {
  id        String    @id @default(uuid())
  userId    String
  asset     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  priceBuy  Float
  priceSell Float
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, asset])
}

model CryptoWallet {
  id         String         @id @default(uuid())
  userId     String
  currency   CryptoCurrency
  chain      Chain
  address    String         @unique
  createdAt  DateTime       @default(now())
  mnemonic   String
  privateKey String
  User       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency, chain])
  @@index([userId])
}

enum ChatStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum TradeType {
  Buy
  Sell
}

enum TradeStatus {
  Completed
  Pending
  Cancelled
}

enum PositionStatus {
  Active
  Closed
  Liquidated
}

enum Chain {
  BITCOIN
  ETHEREUM
  TRON
}

enum CryptoCurrency {
  BTC
  USDT
  ETH
  TRX
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  PENDING
}
