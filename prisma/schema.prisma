generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String     @unique
  firstName    String
  lastName     String
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  isVerifed    Boolean    @default(false)
  walletId     String     @unique
  accounts     Account[]
  positions    Position[]
  trades       Trade[]
  wallet       Wallet     @relation(fields: [walletId], references: [id])
  supportChats     SupportChat[]
  sentMessages     SupportMessage[] @relation("SenderMessages")
}
model SupportChat {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  subject    String
  status     ChatStatus        @default(OPEN)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  closedAt   DateTime?
  messages   SupportMessage[]

  @@index([userId])
}

enum ChatStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model SupportMessage {
  id         String      @id @default(uuid())
  chatId     String
  chat       SupportChat @relation(fields: [chatId], references: [id])
  senderId   String 
  sender     User        @relation("SenderMessages", fields: [senderId], references: [id])
  content    String      @db.Text
  isSupport  Boolean     @default(false) 
  isRead     Boolean     @default(false) 
  createdAt  DateTime    @default(now())
  @@index([chatId])
  @@index([senderId])
}


model Wallet {
  id        String   @id @default(uuid())
  balance   Float    @default(0)
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  withdrawn Float    @default(0)
  user      User?
}

model Account {
  id         String     @id @default(uuid())
  mt5Id      String     @unique
  isDemo     Boolean    @default(true)
  type       String
  balance    Float
  freeMargin Float
  currency   String     @default("USD")
  userId     String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id])
  positions  Position[]
  trades     Trade[]
}

model Trade {
  id         String      @id @default(uuid())
  asset      String
  type       TradeType
  quantity   Float
  price      Float
  total      Float
  status     TradeStatus
  startDate  DateTime
  endDate    DateTime
  userId     String
  createdAt  DateTime    @default(now())
  accountId  String
  stopLoss   Float?
  takeProfit Float?
  account    Account     @relation(fields: [accountId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
}

model Position {
  id        String         @id @default(uuid())
  asset     String
  type      TradeType
  quantity  Float
  entry     Float
  current   Float
  pnl       Float
  status    PositionStatus
  date      DateTime
  userId    String
  createdAt DateTime       @default(now())
  accountId String
  endDate   DateTime?
  startDate DateTime       @default(now())
  account   Account        @relation(fields: [accountId], references: [id])
  user      User           @relation(fields: [userId], references: [id])
}

enum TradeType {
  Buy
  Sell
}

enum TradeStatus {
  Completed
  Pending
  Cancelled
}

enum PositionStatus {
  Active
  Closed
  Liquidated
}
